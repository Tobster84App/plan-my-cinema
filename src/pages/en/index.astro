---
import Base from '../../layouts/Base.astro';
import { path } from '../../i18n/routes';
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: 'Plan My Cinema', url: 'https://plan-my-cinema.com/en/', inLanguage: 'en' }];
---
<Base lang="en" page="home" title="Home" description="Home cinema calculators for enthusiasts: screen, throw, brightness in nits and foot-lamberts, room modes and Dolby Atmos speaker layouts – all built on your room." jsonLd={jsonLd}>
  <div class="page-head">
    <h1>Plan <span>My</span> Cinema</h1>
    <p>Describe your room once – dimensions, screen, projector, seat. Every calculator on this site works from that same model. Nothing leaves your browser.</p>
  </div>
  <div class="tiles">
    <a class="tile" href={path('screen', 'en')}>
      <span class="tag">Calculator 1</span>
      <h2>Screen &amp; projection</h2>
      <p>Throw distance, brightness in nits and fL, AT fabric loss, zoom vs. anamorphic lens, lens shift and seating distance.</p>
    </a>
    <a class="tile" href={path('modes', 'en')}>
      <span class="tag">Calculator 2</span>
      <h2>Room modes</h2>
      <p>Axial, tangential and oblique modes of your room – and which of them reach your seat, with one or several subwoofers.</p>
    </a>
    <a class="tile" href={path('speakers', 'en')}>
      <span class="tag">Calculator 3</span>
      <h2>Speakers</h2>
      <p>Dolby Atmos layouts from 5.1 to 9.1.6 with automatic placement, checked against Dolby’s placement angles.</p>
    </a>
    <a class="tile" href={path('levels', 'en')}>
      <span class="tag">Calculator 4</span>
      <h2>SPL &amp; amplifier</h2>
      <p>Can your speakers and amplifier reach Dolby’s calibration level? Power needed and headroom for every speaker.</p>
    </a>
  </div>
  <section class="prose" style="margin-top: 32px">
    <h2>Why this site exists</h2>
    <p>
      Plan My Cinema grew out of building my own home cinema: the numbers I needed were scattered across data sheets, guidelines and textbooks, and
      every calculator wanted the room dimensions again. Here you enter your room once – with sources instead of rules of thumb.{' '}
      <a href={path('about', 'en')}>More about the project and how to send questions</a>.
    </p>
  </section>
</Base>
